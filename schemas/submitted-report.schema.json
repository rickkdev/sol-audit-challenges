{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sol-audit-challenges/submitted-report.schema.json",
  "title": "SubmittedFindingReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "findings"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^case-[0-9]{4}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "affected_files",
          "root_cause",
          "impact",
          "proof_sketch"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "affected_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1 }
              }
            }
          },
          "root_cause": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "proof_sketch": { "type": "string", "minLength": 1 },
          "reproduction_steps": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
