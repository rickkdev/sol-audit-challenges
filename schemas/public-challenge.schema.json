{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sol-audit-challenges/public-challenge.schema.json",
  "title": "PublicChallenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "language", "package", "prompt"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^case-[0-9]{4}$"
    },
    "language": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "sha256"],
      "properties": {
        "type": { "enum": ["archive", "container"] },
        "path": { "type": "string" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "network": { "enum": ["disabled"] }
      }
    }
  }
}
